# ==============================================================================
# AquaGuardian - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Add your keys when available. The application will run seamlessly in 
#    DEMO MODE with realistic AI assessments and simulated responses if keys are omitted.
# ==============================================================================

# AI PROVIDER CONFIGURATION
# Supported providers: demo, groq, google, openai, anthropic
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL_NAME=

# Or Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=

# Optional secondary AI provider
SECONDARY_AI_PROVIDER=
SECONDARY_AI_API_KEY=
SECONDARY_AI_MODEL_NAME=

# Weather API (Optional - Open-Meteo fallback active)
WEATHER_API_KEY=

# Maps / Geolocation (Optional - OpenStreetMap Leaflet active)
MAPS_API_KEY=

# Database Configuration (Defaults to lightweight persistent SQLite if blank)
DATABASE_URL=

# Cloud Storage / Media Uploads (Optional, local storage used by default)
STORAGE_API_KEY=

# Application & Server Configuration
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
BACKEND_PORT=8000
